# Copy to .env (or set as environment variables) to configure the portal.
# All values are optional; the admin can also set the PhishAwareness
# connection from the in-app Settings screen after first login.

PORTAL_PORT=8100
PORTAL_DATABASE_URL=sqlite:///./portal.db
PORTAL_SECRET_KEY=change-me-to-a-long-random-string

# PhishAwareness REST connection (boot defaults / fallback).
PA_BASE_URL=http://127.0.0.1:8000
PA_TENANT_ID=
# Service token for the /portal automation surface - generate/rotate it on
# the PhishAwareness side (Manage -> Integration -> "Portal service token").
PA_SERVICE_TOKEN=
PA_VERIFY_TLS=1

# Escalation policy.
PORTAL_ONBOARDING_FLOOR=35
PORTAL_INPERSON_AFTER_DAYS=30

# Background auto-sync loop (seconds). 0 = disabled (sync from the admin UI).
PORTAL_AUTO_SYNC_SECONDS=0

# --- production hardening (see ../SECURITY.md) ---
# PORTAL_ENV=production emits HSTS, disables /docs, and requires a non-default
# PORTAL_SECRET_KEY (fail-fast).
# PORTAL_ENV=production
# Encrypts Setting.pa_service_token and TicketConfig.auth_header_value at
# rest. REQUIRED in production (fail-fast on the dev default). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PORTAL_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
# Cross-origin access is OFF by default (the SPA is same-origin). Set an
# explicit origin list only if you serve the SPA from a different origin.
# PORTAL_CORS_ORIGINS=https://portal.yourdomain
# Per-IP requests/minute on the auth endpoints (0 = off; set e.g. 30 in prod).
PORTAL_RATE_LIMIT_PER_MINUTE=0
