# Copy to .env and adjust. docker-compose reads these.
SECRET_KEY=change-me-to-a-long-random-string

# Local (non-Docker) run against SQLite:
#   export DATABASE_URL="sqlite:///./dev.db"
# Docker uses the Postgres URL defined in docker-compose.yml automatically.

# --- scoring calibration -------------------------------------------------
# How the headline HRS combines a person's campaigns:
#   average  (default) decay-weighted mean; one bad failure is diluted
#   peak     the single worst campaign; a bad failure always stands out
#   blend    HRS_BLEND_ALPHA*peak + (1-alpha)*average
HRS_AGGREGATION=blend
HRS_BLEND_ALPHA=0.5

# --- schema management ---------------------------------------------------
# Set to 1 to manage the schema with Alembic migrations instead of the
# app's create-all-on-startup (recommended once real data lives in the DB).
USE_ALEMBIC=

# --- integrations --------------------------------------------------------
# Shared secret configured on the GoPhish webhook (enables signature checks).
GOPHISH_WEBHOOK_SECRET=


# Shared token embedded in simulation landing pages (spam-guard for the public
# beacon endpoint; not secret-grade). Empty = accept unsigned (dev only).
BEACON_INGEST_TOKEN=
