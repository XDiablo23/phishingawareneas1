  SYNC -- "pull results" --> GP
  LP -- "dwell / focus / typed" --> BE
  WH --> ING
  BE --> ING
  SYNC --> ING
  ROSTER --> SCORE
  ING --> SCORE --> SC --> API --> UI
  ROSTER --> API
  TRAIN --- EMP
