# Copy to backend/.env to override defaults for bare local runs.
# Docker Compose sets these directly; CI uses its own env.

# Local default is SQLite (no setup needed). Uncomment for Postgres:
# DATABASE_URL=postgresql+psycopg2://phish:phish@db:5432/phishawareness
DATABASE_URL=sqlite:///./phishawareness.db

SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480

# HRS aggregation: average | peak | blend
HRS_AGGREGATION=blend
HRS_BLEND_ALPHA=0.5

# Set to any value to skip create_all and use Alembic migrations instead
# USE_ALEMBIC=1

# Shared secret for the GoPhish webhook (empty = accept unsigned, dev only)
GOPHISH_WEBHOOK_SECRET=


# Shared token embedded in simulation landing pages (spam-guard for the public
# beacon endpoint; not secret-grade). Empty = accept unsigned (dev only).
BEACON_INGEST_TOKEN=


# GoPhish REST API (server defaults; a tenant can override in the console).
# Used for read-only sync AND the operator campaign-control surface.
GOPHISH_API_URL=https://127.0.0.1:3333
GOPHISH_API_KEY=
# GOPHISH_VERIFY_TLS=1

# Microsoft Entra ID (Azure AD) directory sync (server defaults; overridable
# per tenant in the console). App registration with User.Read.All (or
# Directory.Read.All) application permission, admin-consented. Reads directory
# metadata only — never user credentials.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# On-prem Active Directory over LDAP (alternative to Entra; server defaults,
# overridable per tenant in the console). Read-only service account; metadata
# only. Prefer ldaps:// in production.
LDAP_URI=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
# LDAP_USER_FILTER=(&(objectClass=user)(objectCategory=person))

# --- production hardening (see SECURITY.md) ---
# ENV=production disables /docs + synthetic seeding, emits HSTS, and makes the
# webhook/beacon fail closed when no secret is configured.
# ENV=production
# Strong random key REQUIRED in production (fail-fast on the dev default).
# SECRET_KEY=replace-with-64-random-hex-chars
# Encrypts tenant secret columns at rest (webhook_secret, ingest_token,
# gophish_api_key, entra_client_secret, ldap_bind_password). REQUIRED in
# production (fail-fast on the dev default, same as SECRET_KEY). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=replace-with-a-generated-fernet-key
# Allowed console origins (never "*" in production).
# CORS_ORIGINS=https://console.yourdomain
# Per-IP requests/minute on auth + ingestion (0 = off; set e.g. 60 in prod).
RATE_LIMIT_PER_MINUTE=0
# Max accepted upload size (MB) for CSV import / event CSV.
MAX_UPLOAD_MB=10
# Verify GoPhish's TLS cert (set 1 with a real cert in production). This is
# the server-wide default; a tenant can override it independently under
# Manage -> Integration -> GoPhish sync.
# GOPHISH_VERIFY_TLS=1
